{
  "name": "paseo-live-view",
  "version": "0.1.1",
  "description": "Watch your Paseo agents work like a VS Code screen: live file edits with a moving pointer, a terminal of every command, PR review mode with pinned findings, and a separate replay for each subagent.",
  "license": "MIT",
  "author": "nadirdeveloper",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nadirdeveloper/paseo-live-view.git"
  },
  "homepage": "https://github.com/nadirdeveloper/paseo-live-view#readme",
  "bugs": {
    "url": "https://github.com/nadirdeveloper/paseo-live-view/issues"
  },
  "keywords": [
    "paseo",
    "paseo-plugin",
    "claude-code",
    "ai-agents",
    "code-review",
    "live-view"
  ],
  "private": true,
  "files": [
    "paseo-plugin.json",
    "OVERVIEW.md",
    "OVERVIEW.*.md",
    "index.client.ts",
    "index.client.tsx",
    "index.server.ts",
    "index.server.tsx",
    "client/",
    "server/",
    "shared/",
    "assets/",
    "LICENSE",
    "!**/*.test.ts",
    "!server/fixtures/**"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.17.4",
    "@getpaseo/protocol": "0.17.4",
    "@tanstack/react-query": "^5.90.11",
    "@types/react": "~19.2.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.2",
    "zod": "^4.4.3"
  }
}
